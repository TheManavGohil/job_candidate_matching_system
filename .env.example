# ── Database ──
DATABASE_URL=postgresql+asyncpg://matcher:matcher_secret@db:5432/matcher_db

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Qdrant ──
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── LlamaParse (PDF parsing) ──
LLAMA_CLOUD_API_KEY=llx-your-key

# ── Groq (LLM) ──
GROQ_API_KEY=gsk_your-key

# ── Auth ──
JWT_SECRET=change-me-in-production

# ── Embeddings ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_CANDIDATES_RETRIEVAL=500
